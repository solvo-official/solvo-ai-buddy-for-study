# ==========================================
# SOLVO - Environment Variables Template
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_token_here_change_in_production

# Google OAuth & Identity Services (Google Cloud Console OAuth 2.0 Client ID)
# Used for "Continue with Google" sign in
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Resource Storage Configuration (Optional - Defaults to E:\ or /tmp on Vercel)
# RESOURCE_DRIVE=E:
# DATA_DIR=E:\study assistant\data
# UPLOADS_DIR=E:\study assistant\uploads
# TEMP_DIR=E:\study assistant\tmp
